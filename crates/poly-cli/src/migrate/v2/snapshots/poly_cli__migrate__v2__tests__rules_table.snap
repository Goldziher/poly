---
source: crates/poly-cli/src/migrate/v2/tests.rs
expression: output
---
required_version = ">=2.0.0"

[engines.astgrep]
select = ["no-unwrap"]
# user rule directories
rule_dirs = [".poly/rules", "tools/rules"]
builtin_pack = false

[engines.typos]
# typos is opt-in in poly v2; this keeps the v1 default (on).
enabled = true
