---
source: crates/poly-cli/tests/migrate_hooks.rs
expression: rendered
---
[hooks.builtin]
fmt = { jobs = [
  { exclude = ["armis/pipeline/ios_like_ssh/test_files/*.log", "*.tar", "*.gz", "*.svg", "*.snap", "*.zip"], fix = true },
  { files = ["**/*.proto"], fix = true },
  { files = ["*.go"], fix = true },
  { files = ["*.groovy"], exclude = ["playground/**"], fix = true, priority = 1 },
  { files = ["*.java"], exclude = ["playground/**"], fix = true },
  { files = ["*.rb"], fix = true },
  { files = ["*.{py,pyi}"], fix = true },
  { files = ["*BUILD", "*BUILD.bazel", "*.BUILD", "*.bzl"], fix = true },
  { files = ["pyproject.toml", "**/pyproject.toml"], exclude = ["*armis/public_sdks/python/public/pyproject.toml*"], fix = true, priority = 2 },
] }
lint = { jobs = [
  { files = ["**/*.proto"], priority = 4 },
  { files = ["**/{Chart.yaml,Chart.lock,requirements.yaml,requirements.lock,values.yaml,values.schema.json,templates/**}"], priority = 4 },
  { files = ["*.go"], priority = 4 },
  { files = ["*.groovy"], exclude = ["playground/**"], fix = true },
  { files = ["*.java"], exclude = ["playground/**"], priority = 4 },
  { files = ["*.{js,jsx,ts,tsx,mjs,cjs}"], fix = true },
  { files = ["*.{py,pyi}"], fix = true, priority = 1 },
  { files = ["*.{py,pyi}"], exclude = ["products/em/backend/*"], priority = 3 },
  { files = ["*.{yml,yaml}"], exclude = ["armis/service_charts/*/templates/*", "deploy/manifests/jenkins_k8s_plugin.yaml"], priority = 3 },
  { files = ["*BUILD", "*BUILD.bazel", "*.BUILD", "*.bzl"], priority = 3 },
  { files = [".github/workflows/*.{yml,yaml}"], exclude = [".github/workflows/*/*"], priority = 4 },
  { files = ["products/em/backend/*"], priority = 3 },
] }
file_safety = { jobs = [
  { checks = ["aws_credentials", "private_key"] },
  { checks = ["added_large_files"], exclude = ["demo/data/*", "vmlinux_arm64.h", "vmlinux.h"] },
], max_added_file_kb = 1000, merge_conflict = false, case_conflict = false, executables_have_shebangs = false, shebang_scripts_are_executable = false, aws_credentials = true }
[hooks.post-checkout.commands.check-env-lock]
run = "bash .lefthook/check_env_lock.sh {0}"
workspace = true
[hooks.post-merge.commands.check-env-lock]
run = "bash .lefthook/check_env_lock.sh {0}"
workspace = true
[hooks.pre-commit]
parallel = true
[hooks.pre-commit.scripts.oxfmt]
script = ".lefthook/oxfmt.sh"
runner = "bash"
files = ["*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,toml,yml,yaml,md,mdx}"]
stage_fixed = true
priority = 1
[hooks.pre-commit.scripts.va-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["products/va", "run type-check"]
files = ["products/va/*.{ts,tsx,json}"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.va-visual]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["products/va", "run test:visual"]
files = ["products/va/src/views/*.tsx"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.rms-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["products/rms", "run type-check", "run test"]
files = ["products/rms/*.{js,jsx,ts,tsx,json}"]
exclude = ["products/rms/dev_tools/**"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.ui-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["products/packages/ui", "run type-check", "run test:run"]
files = ["products/packages/ui/*.{js,jsx,ts,tsx,json}"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.icons-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["products/packages/icons", "run type-check", "run validate-svgs"]
files = ["products/packages/icons/*.{js,jsx,ts,tsx,svg,json}"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.uikit-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["armis/common/js/packages/uikit", "tsc --noEmit"]
files = ["armis/common/js/packages/uikit/*.{js,jsx,ts,tsx,json}"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.sra-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["armis/services/sra_app_web", "run typecheck", "run test"]
files = ["armis/services/sra_app_web/*.{js,jsx,ts,tsx,json}"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.armis-assistant-check]
script = ".lefthook/pnpm_gate.sh"
runner = "bash"
args = ["products/platform/armis-assistant", "run type-check", "run test"]
files = ["products/platform/armis-assistant/*.{js,jsx,ts,tsx,json}"]
workspace = true
priority = 4
[hooks.pre-commit.scripts.test-file-names]
script = "dev_tools/validate_test_names/check_names.sh"
runner = "bash"
files = ["*.{py,js,jsx,mjs,cjs,ts,tsx,mts,cts,go,java,rs,sh,bash,bats}"]
exclude = ["playground/**", "armis/tenant_server/fe/qa_tests/**"]
priority = 4
[hooks.pre-commit.commands.env-lock-check]
run = "acli lock-env"
files = ["Brewfile", "pyproject.toml", ".python-version", ".nvmrc", "package.json", ".java-version", ".checkstyle-version", "dev_tools/acli/acli/commands/doctor_subscriptions/checkstyle.py", ".palantir-java-format-version", "dev_tools/acli/acli/commands/doctor_subscriptions/palantir_format.py", "pnpm-lock.yaml", "go.work", "dev_tools/acli/acli/commands/doctor.py", "dev_tools/acli/acli/commands/doctor_subscriptions/dependencies.py", "dev_tools/acli/acli/commands/doctor_subscriptions/nvm.py", ".lefthook/check_env_lock.sh", "acli.lock"]
workspace = true
priority = 4
[hooks.pre-commit.commands.prek-hooks]
run = "prek run --hook-stage pre-commit --files {staged_files}"
priority = 3
[hooks.prepare-commit-msg.scripts.custom_prepare_commit_msg]
script = ".lefthook/prepare-commit-msg/custom_prepare_commit_msg.sh"
runner = "bash"
workspace = true
[tools.actionlint]
enabled = true
files = [".github/workflows/*.{yml,yaml}"]
exclude = [".github/workflows/*/*"]
extra_args = ["-ignore", "SC2129", "-ignore", "SC2016"]
[tools.buf]
enabled = true
files = ["**/*.proto"]
[tools.buildifier]
enabled = true
version = "8.5.1"
install = "auto"
files = ["*BUILD", "*BUILD.bazel", "*.BUILD", "*.bzl"]
extra_args = ["--warnings=-native-build"]
format_extra_args = ["-lint=fix"]
[tools.checkstyle]
enabled = true
files = ["*.java"]
exclude = ["playground/**"]
extra_args = ["-c", "checkstyle.xml", "-p", "checkstyle.properties"]
[tools.golangci-lint]
enabled = true
new_from_rev = "HEAD"
files = ["*.go"]
extra_args = ["-c", ".golangci.yml"]
[tools.helm]
enabled = true
files = ["**/{Chart.yaml,Chart.lock,requirements.yaml,requirements.lock,values.yaml,values.schema.json,templates/**}"]
[tools.helm-template]
enabled = true
files = ["**/{Chart.yaml,Chart.lock,requirements.yaml,requirements.lock,values.yaml,values.schema.json,templates/**}"]
[tools.npm-groovy-lint]
enabled = true
files = ["*.groovy"]
exclude = ["playground/**"]
[tools.palantir-java-format]
enabled = true
command = "aosp"
files = ["*.java"]
exclude = ["playground/**"]
[tools.pyproject-fmt]
enabled = true
files = ["pyproject.toml", "**/pyproject.toml"]
exclude = ["*armis/public_sdks/python/public/pyproject.toml*"]
extra_args = ["--keep-full-version"]
[lint.python.ruff]
unsafe_fixes = true
