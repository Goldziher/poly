---
source: crates/poly-cli/tests/migrate.rs
expression: poly
---
[lint.python.ruff]
line_length = 100
select = ["E", "F", "I"]
ignore = ["E501"]

[lint.typos]
extend_identifiers = { HASHs = "HASHs" }
extend_ignore_words = ["ba", "crate"]

[fmt.python.ruff]
line_length = 100
docstring_code_format = false
line_ending = "auto"

[per-file-ignores]
"tests/**" = ["S101"]
