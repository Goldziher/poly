    ],
    "languages": [
      "java"
    ],
    "homepage": "https://github.com/palantir/palantir-java-format",
    "commands": {
      "format": {
        "arguments": [
          "--palantir",
          "--replace",
          "$FILES"
        ],
        "stdin": false
      },
      "aosp": {
        "arguments": [
          "--aosp",
          "--skip-sorting-imports",
          "--replace",
          "$FILES"
        ],
        "stdin": false,
        "then": [
          {
            "arguments": [
              "--palantir",
