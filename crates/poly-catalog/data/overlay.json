  {
    "name": "golangci-lint",
    "binary": "golangci-lint",
    "categories": [
      "formatter",
      "linter"
    ],
    "languages": [
      "go"
    ],
    "homepage": "https://github.com/golangci/golangci-lint",
    "commands": {
      "format": {
        "arguments": [
          "fmt",
          "$FILES"
        ],
        "stdin": false
      },
      "lint": {
        "arguments": [
          "run",
          "--output.json.path=stdout",
          "--output.text.path=",
          "$DIR"
        ],
        "stdin": false
      },
      "fix": {
        "arguments": [
          "run",
          "--fix",
          "--output.json.path=stdout",
          "--output.text.path=",
          "$DIR"
        ],
        "stdin": false
      }
    },
    "recipe": {
      "output": "golangci_json",
      "group": {
        "marker": [
          "go.mod"
        ]
      },
      "target": "dir",
      "serial": true,
      "dependencies": [
        "**/*.go",
        "go.mod",
        "go.sum"
      ],
      "config_flags": [
        "-c",
        "--config"
      ],
      "config_files": [
        ".golangci.yml",
        ".golangci.yaml",
        ".golangci.toml",
        ".golangci.json"
      ],
      "ok_exits": [
        1
      ],
      "install": {
        "hint": "brew install golangci-lint"
      },
      "new_from_rev_flag": "--new-from-rev"
    }
  },
  {
    "name": "helm",
