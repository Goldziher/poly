      "**/requirements.yaml",
      "**/requirements.lock",
      "**/values.yaml",
      "**/values.schema.json",
      "**/templates/**"
    ],
    "commands": {
      "lint": {
        "arguments": [
          "lint",
          "$ROOT"
        ],
        "stdin": false
      },
      "dependency-build": {
        "arguments": [
          "dependency",
          "build",
          "$ROOT"
        ],
        "stdin": false
      }
    },
    "recipe": {
      "output": "helm_text",
      "group": {
        "marker": [
          "Chart.yaml"
        ]
      },
      "target": "root",
      "findings": "all",
      "dependencies": [
        "**"
      ],
      "install": {
        "hint": "brew install helm"
      },
      "prepare": "dependency-build",
      "values_flag": "-f"
    }
