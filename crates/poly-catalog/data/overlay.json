  {
    "name": "checkstyle",
    "binary": "checkstyle",
    "categories": [
      "linter"
    ],
    "languages": [
      "java"
    ],
    "homepage": "https://checkstyle.org",
    "commands": {
      "lint": {
        "arguments": [
          "-f",
          "xml",
          "$FILES"
        ],
        "stdin": false
      }
    },
    "recipe": {
      "output": "checkstyle_xml",
      "config_flags": [
        "-c",
        "-p"
      ],
      "java": true,
      "shard_floor": 25,
      "install": {
        "hint": "brew install checkstyle, or set [tools.checkstyle] version to a pinned release poly can download",
        "releases": {
          "12.3.1": {
            "kind": "jar",
            "assets": {
              "any": {
                "url": "https://github.com/checkstyle/checkstyle/releases/download/checkstyle-12.3.1/checkstyle-12.3.1-all.jar",
                "sha256": "4ecdfa8504452e1557d2e2c364085f0ae5703b67ec9c759976ca378d41cb8f7a"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "palantir-java-format",
    "binary": "palantir-java-format",
    "categories": [
      "formatter"
    ],
    "languages": [
      "java"
    ],
    "homepage": "https://github.com/palantir/palantir-java-format",
    "commands": {
      "format": {
        "arguments": [
          "--palantir",
          "--replace",
          "$FILES"
        ],
        "stdin": false
      },
      "aosp": {
        "arguments": [
          "--aosp",
          "--skip-sorting-imports",
          "--replace",
          "$FILES"
        ],
        "stdin": false,
        "then": [
          {
            "arguments": [
              "--palantir",
              "--fix-imports-only",
              "--replace",
              "$FILES"
            ],
            "stdin": false
          }
        ]
      }
    },
    "recipe": {
      "install": {
        "hint": "download palantir-java-format-native from Maven Central, or set [tools.palantir-java-format] version to a pinned release poly can download",
        "releases": {
