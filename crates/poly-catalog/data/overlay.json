        ],
        "stdin": false
      },
      "lint": {
        "arguments": [
          "--no-insight",
          "--output",
          "json",
          "--failon",
          "none",
          "$FILES"
        ],
        "stdin": false
      },
      "fix": {
        "arguments": [
          "--no-insight",
          "--fix",
          "--failon",
          "none",
          "$FILES"
        ],
        "stdin": false
      }
    },
    "recipe": {
      "output": "groovy_json",
      "fix": "fix",
      "java": false,
      "shard_floor": 25,
      "config_files": [
        ".groovylintrc.json",
        ".groovylintrc.js",
        ".groovylintrc.cjs"
      ],
      "install": {
        "hint": "npm install --global npm-groovy-lint"
      }
    }
  }
