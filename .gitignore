/target
# poly's result cache + hook snapshot live in the per-user cache dir
# (~/.cache/poly on Linux), never in the repo — nothing to ignore here.

poly.local.toml

# Wrapper-package build artifacts. The prebuilt binaries are staged into the npm
# platform packages and the wheels at publish time from the release archives —
# they are never committed, so a checkout can never carry a binary that
# disagrees with the release it claims to be.
npm-package/platforms/*/bin/
npm-package/*.tgz
npm-package/platforms/*/*.tgz
npm-package/node_modules/
pip-package/dist/
pip-package/*.egg-info/
__pycache__/


# `ai-rulez generate --plugin` emits one bundle per runtime named in
# .ai-rulez/config.toml [plugin] runtimes. All eight are committed — a
# marketplace install serves these files directly, so an ignored bundle is a
# harness poly silently does not support. .ai-rulez-generated.json is the BLAKE3
# provenance sidecar `ai-rulez verify --plugin` checks against, so it is
# committed too.
#
# Hermes is deliberately not a runtime (see the comment on `runtimes`); ignore
# its output so a stray generation cannot be committed by accident.
.hermes/

# BEGIN ai-rulez (DO NOT EDIT - managed by ai-rulez)
.agents/skills/
.ai-rulez/.generated-manifest.json
.ai-rulez/.generated-manifest.local.json
.ai-rulez/config.local.*
.ai-rulez/local/
.claude/
.codex/
.mcp.json
.opencode/agents/
.opencode/commands/
.pi/agents/
.pi/mcp.json
AGENTS.md
CLAUDE.md
# END ai-rulez

# Distributable Pi prompts override the contributor-output ignore above. ~keep
!.pi/prompts/
.pi/prompts/*
!.pi/prompts/poly-check.md
!.pi/prompts/poly-fix.md
/*.tgz

opencode.json
