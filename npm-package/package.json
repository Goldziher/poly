{
  "name": "@goldziher/polylint",
  "version": "0.34.0",
  "description": "polylint: one linter & formatter for every language in your repository. Installs the prebuilt poly binary and puts `poly` on PATH.",
  "keywords": [
    "linter",
    "formatter",
    "lint",
    "format",
    "polyglot",
    "poly",
    "rust"
  ],
  "homepage": "https://github.com/Goldziher/polylint#readme",
  "bugs": {
    "url": "https://github.com/Goldziher/polylint/issues"
  },
  "license": "MIT",
  "author": "Na'aman Hirschfeld <nhirschfeld@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goldziher/polylint.git",
    "directory": "npm-package"
  },
  "bin": {
    "poly": "bin/poly.js",
    "polylint": "bin/poly.js"
  },
  "main": "index.js",
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "bin/poly.js"
  ],
  "optionalDependencies": {
    "@goldziher/polylint-darwin-arm64": "0.34.0",
    "@goldziher/polylint-linux-arm64-gnu": "0.34.0",
    "@goldziher/polylint-linux-x64-gnu": "0.34.0",
    "@goldziher/polylint-linux-x64-musl": "0.34.0",
    "@goldziher/polylint-win32-x64": "0.34.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
